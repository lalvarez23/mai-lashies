{
  "name": "mai-lashies",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "tsx watch server/index.ts",
    "db:start": "node scripts/database.mjs",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "setup": "node scripts/setup.mjs",
    "build": "tsc --noEmit && vite build",
    "build:vercel": "node scripts/vercel-build.mjs",
    "db:cloud:prepare": "node scripts/cloud-database.mjs",
    "db:cloud:import": "node scripts/migrate-to-cloud.mjs",
    "test": "node scripts/test.mjs",
    "backup": "node scripts/backup.mjs",
    "backup:cloud": "node scripts/cloud-backup.mjs",
    "restore": "node scripts/restore.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@vercel/functions": "^3.10.6",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "embedded-postgres": "18.6.0-beta.19",
    "prettier": "^3.9.10",
    "prisma": "7.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.3.0"
  }
}
